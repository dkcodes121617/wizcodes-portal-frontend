# Template. Copy to .env.local for local development:
#
#     cp .env.example .env.local      (macOS/Linux)
#     copy .env.example .env.local    (Windows)
#
# Nothing here is required. Every variable has a working fallback in
# src/lib/urls.ts, so a missing file never breaks the app:
#
#     dev build         -> http://localhost:8000
#     production build  -> https://wizcodes-portal-backend.onrender.com
#
# Set a variable only when you want something other than those defaults.
# In production these live in the Vercel dashboard — no .env file is deployed.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at BUILD
# time. Never put a secret behind that prefix, and remember that changing one
# requires a redeploy, not just a restart.

# --- the single frontend <-> backend link ---
# Local backend:    http://localhost:8000
# Deployed backend: https://wizcodes-portal-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- canonical site URL (optional) ---
# Only needed for a custom domain. Production already resolves to
# https://wizcodes-portal-frontend.vercel.app, and previews use their own
# VERCEL_URL automatically.
# NEXT_PUBLIC_SITE_URL=https://portal.wizcodes.com
