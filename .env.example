# Copy to .env.local for local development:  cp .env.example .env.local
# In production these are set in the Vercel dashboard — no .env file is deployed.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at BUILD
# time. Never put a secret behind that prefix, and remember that changing one
# requires a redeploy, not just a restart.

# --- the single frontend <-> backend link ---
# Local:      http://localhost:8000
# Production: https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- canonical site URL (optional) ---
# Used for absolute OG/canonical URLs. Falls back to VERCEL_URL, then localhost,
# so it only needs setting if you serve from a custom domain.
# NEXT_PUBLIC_SITE_URL=https://portal.wizcodes.com
